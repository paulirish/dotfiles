# ~/.bash_prompt — managed by dotfiles
# Git-aware PS1 prompt.  Inspired by gf3, sindresorhus, mathiasbynens, paulirish.

# Bail out immediately if running under zsh
[[ -n "$ZSH_VERSION" ]] && { return 1 2>/dev/null || exit 1; }

# Suppress user@host when logged in as the "expected" user on a known machine.
# Set DOTFILES_USER in ~/.extra to override (default: current user).
DOTFILES_USER="${DOTFILES_USER:-$(id -un)}"

# Trim prompt to last 2 path components (requires Bash 4.x)
PROMPT_DIRTRIM=2

_set_prompts() {
    local bold="" reset="" black="" blue="" cyan="" green="" \
          orange="" purple="" red="" violet="" magenta="" white="" yellow=""

    if [ -x /usr/bin/tput ] && tput setaf 1 &>/dev/null; then
        tput sgr0
        bold=$(tput bold)
        reset=$(tput sgr0)
        # Solarized palette
        black=$(tput setaf 0)
        blue=$(tput setaf 33)
        cyan=$(tput setaf 37)
        green=$(tput setaf 190)
        orange=$(tput setaf 172)
        purple=$(tput setaf 141)
        red=$(tput setaf 124)
        violet=$(tput setaf 61)
        magenta=$(tput setaf 9)
        white=$(tput setaf 8)
        yellow=$(tput setaf 136)
    else
        reset="\e[0m"
        black="\e[1;30m";  blue="\e[1;34m";   cyan="\e[1;36m"
        green="\e[1;32m";  orange="\e[1;33m"; purple="\e[1;35m"
        red="\e[1;31m";    magenta="\e[1;31m"; violet="\e[1;35m"
        white="\e[1;37m";  yellow="\e[1;33m"
    fi

    # user@host — only shown when $USER != $DOTFILES_USER (i.e. on a foreign machine)
    _usernamehost() {
        local style="${magenta}"
        [[ "$USER" == *root* ]] && style="${red}"
        local part
        part="\[${style}\]${USER}\[${white}\] at \[${orange}\]${HOSTNAME}\[${white}\] in"
        [ "$USER" != "$DOTFILES_USER" ] && printf '%s ' "$part"
    }

    # Fast git branch + dirty indicator (>5× faster than mathias's version)
    _prompt_git() {
        git rev-parse --is-inside-work-tree &>/dev/null || return

        local branch dirty=""
        branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null \
            || git describe --all --exact-match HEAD 2>/dev/null \
            || git rev-parse --short HEAD 2>/dev/null \
            || echo '(unknown)')"

        dirty="$(git diff --no-ext-diff --quiet --ignore-submodules --exit-code 2>/dev/null || echo '*')"

        printf '%s' "${1}${branch}${2}${dirty}"
    }

    # ── Prompt string ──────────────────────────────────────────────────────
    PS1="\[\033]0;\w\007\]"                    # terminal title = cwd
    PS1+="\n\[${bold}\]"
    PS1+="\[$(_usernamehost)\]"                # user@host (hidden when $USER == $DOTFILES_USER)
    PS1+="\[${green}\]\w"                      # working directory
    PS1+="\$(_prompt_git \"\[${white}\] on \[${purple}\]\" \"\[${cyan}\]\")"
    PS1+="\n"
    PS1+="\[${reset}${white}\]\\$ \[${reset}\]"
    export PS1

    export PS2="⚡ "

    # Debug prompt for `set -x`: timestamp + file:line + function
    export PS4='+ \011\e[1;30m\t\011\e[1;34m${BASH_SOURCE}\e[0m:\e[1;36m${LINENO}\e[0m\011 ${FUNCNAME[0]:+\e[0;35m${FUNCNAME[0]}\e[1;30m()\e[0m:\011\011 }'
}

_set_prompts
unset _set_prompts

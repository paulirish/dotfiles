# Make folder and cd into it
mkcd() {
    mkdir "$1"
    cd "$1"
}

delete-merged-branches() {
    git branch --merged | grep -Ev "(^\*|master|main|dev)" | xargs git branch -d
}

# Interactive rebase from the repo's default branch (falls back to master)
grim() {
    local base
    base=$(git mainormaster 2>/dev/null)
    base=${base:-master}
    git rebase -i "$(git merge-base "$base" HEAD)"
}

# Claude Code: ~/.claude is the personal account (default); work repos use
# ~/.claude-work.
# Log in once per config dir with /login.
claude() {
  case "$PWD" in
    "$HOME"/code/work|"$HOME"/code/work/*)
      CLAUDE_CONFIG_DIR="$HOME/.claude-work" command claude "$@" ;;
    *)
      GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null)" command claude "$@" ;;
  esac
}
